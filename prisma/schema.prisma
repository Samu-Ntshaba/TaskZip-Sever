generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  RUNNER
}

enum RunnerStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum QueueRequestStatus {
  CREATED
  ACCEPTED
  IN_QUEUE
  UPDATING
  READY
  COMPLETED
  CANCELLED
}

enum QueueUpdateType {
  JOINED_QUEUE
  MY_NUMBER
  CURRENTLY_SERVING
  ETA
  NOTE
  STATUS_CHANGE
}

model User {
  id                              String   @id @default(uuid()) @db.Uuid
  email                           String?  @unique
  passwordHash                    String
  role                            Role     @default(USER)
  isEmailVerified                 Boolean  @default(false)
  resetTokenHash                  String?
  resetTokenExpiresAt             DateTime?
  emailVerificationTokenHash      String?
  emailVerificationTokenExpiresAt DateTime?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  profile Profile?
  runnerProfile RunnerProfile?
  queueRequests QueueRequest[] @relation("CustomerQueueRequests")

  @@index([role])
  @@index([resetTokenExpiresAt])
}

model Profile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  fullName   String
  avatarPath String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RunnerProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @unique @db.Uuid
  photoPath          String
  bio                String?
  status             RunnerStatus @default(OFFLINE)
  totalJobsCompleted Int          @default(0)
  avgRating          Float        @default(0)
  reviewCount        Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilitySlots  RunnerAvailabilitySlot[]
  queueRequests      QueueRequest[]

  @@index([userId])
  @@index([status])
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilitySlots RunnerAvailabilitySlot[]
  queueRequests     QueueRequest[]

  @@index([name])
}

model RunnerAvailabilitySlot {
  id         String   @id @default(uuid()) @db.Uuid
  runnerId   String   @db.Uuid
  locationId String?  @db.Uuid
  locationName String?
  dayOfWeek  Int
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  runner   RunnerProfile @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  location Location?     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([runnerId, dayOfWeek, locationId, locationName])
}

model QueueRequest {
  id              String             @id @default(uuid()) @db.Uuid
  customerId      String             @db.Uuid
  runnerId        String             @db.Uuid
  locationId      String             @db.Uuid
  date            DateTime           @db.Date
  timeWindowStart String?
  timeWindowEnd   String?
  instructions    String?
  priceCents      Int?
  status          QueueRequestStatus @default(CREATED)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  customer User          @relation("CustomerQueueRequests", fields: [customerId], references: [id], onDelete: Cascade)
  runner   RunnerProfile @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  location Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  updates  QueueUpdate[]
  review   Review?

  @@index([runnerId, status])
  @@index([customerId])
}

model QueueUpdate {
  id                String          @id @default(uuid()) @db.Uuid
  requestId         String          @db.Uuid
  updateType        QueueUpdateType
  myNumber          Int?
  currentlyServing  Int?
  etaMinutes        Int?
  note              String?
  createdAt         DateTime        @default(now())

  request QueueRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @unique @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  request QueueRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([rating])
}
